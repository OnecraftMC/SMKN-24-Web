# Salin file ini menjadi ".env" lalu sesuaikan nilainya sebelum menjalankan server.

# Port server backend
PORT=4000

# Secret untuk menandatangani token login admin (JWT).
# WAJIB diganti dengan string acak yang panjang & rahasia sebelum dipakai di server sungguhan.
JWT_SECRET=ganti_dengan_string_acak_yang_panjang_dan_rahasia

# Akun admin default yang dibuat otomatis saat pertama kali server dijalankan
# (hanya dipakai jika database masih kosong / belum ada admin sama sekali).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
