# =============================================================================
# Salin file ini menjadi ".env" lalu isi dengan nilai yang sesuai.
# JANGAN commit file ".env" ke git/repo publik!
# =============================================================================

# --- Pilih provider AI: openai | gemini | anthropic ---
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# --- Google Gemini (opsional, jika AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Anthropic Claude (opsional, jika AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Auth ---
JWT_SECRET=ubah-string-ini-menjadi-acak-dan-rahasia
