APP_NAME="SMKN24 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smkn24_migration_staging
DB_USERNAME=root
DB_PASSWORD=

# Blocks schema/data mutation commands when a non-production environment
# targets a remote SQL host. Enable only temporarily for an intentional
# staging migration; never use this override against production.
ALLOW_REMOTE_DB_MUTATIONS=false
# Destructive remote commands (fresh/reset/rollback/wipe/seeding) stay blocked
# even in production unless explicitly approved for one operation.
ALLOW_DESTRUCTIVE_REMOTE_DB_COMMANDS=false

# Must match JWT_SECRET in backend/.env to accept existing admin tokens.
JWT_SECRET=

# Reuse the legacy AI provider settings when running the migrated AI/chat APIs.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_CHAT_PROVIDER=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_BASE_URL=
AI_BK_PROVIDER=
AI_BK_API_KEY=
AI_BK_MODEL=
AI_BK_BASE_URL=
AI_CONTENT_PROVIDER=
AI_CONTENT_API_KEY=
AI_CONTENT_MODEL=
AI_CONTENT_BASE_URL=

# Use Midtrans sandbox keys for staging; never place these values in the frontend.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
CANTEEN_PUBLIC_URL=

PRIVATE_UPLOAD_DIR=../.smkn24-private-uploads
PUBLIC_UPLOAD_DIR=../backend/uploads
UPLOAD_URL_BASE=/backend/uploads/

# Comma-separated origins; keep these aligned with backend/config/config.php.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            NTYM FCORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://macdeep.my.id
