{
  "name": "smkn24/backend-laravel",
  "type": "project",
  "description": "Laravel API backend for SMKN 24 Jakarta, introduced alongside the legacy PHP backend.",
  "keywords": ["laravel", "api", "smkn24"],
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@composer install",
      "@php artisan key:generate"
    ],
    "test": [
      "@php tests/legacy-jwt-smoke.php",
      "@php tests/canteen-seller-token-smoke.php",
      "@php tests/legacy-route-coverage.php"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
