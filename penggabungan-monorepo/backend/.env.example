# =============================================================================
# Salin file ini menjadi ".env" lalu isi dengan nilai yang sesuai.
# JANGAN commit file ".env" ke git/repo publik!
# =============================================================================

# --- Lingkungan aplikasi: local (pengembangan) | production (server publik) ---
# Di production, JWT_SECRET WAJIB diisi — server menolak request bila masih default.
APP_ENV=local

# --- Pilih provider AI: openai | gemini | anthropic ---
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# --- Google Gemini (opsional, jika AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Anthropic Claude (opsional, jika AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Pilihan per fitur (opsional) ---
# Backend punya 3 kegunaan AI yang memakai satu pemanggil provider:
#   AI_CHAT_*    -> /api/chat        (asisten info sekolah, publik)
#   AI_BK_*      -> /api/bk/chat     (triase Bimbingan Konseling, siswa)
#   AI_CONTENT_* -> /api/ai          (penyusun draf konten, admin)
#
# Gunanya: rate limit provider sering dihitung per AKUN. Kalau ketiganya memakai
# satu kunci, fitur yang paling sering dipanggil (chatbot publik) bisa menghabiskan
# kuota dan membuat dua fitur lain ikut gagal.
#
# Cara pakai:
#   1. Isi nilai global di atas seperti biasa. Ketiga fitur langsung ikut hidup.
#   2. Kalau perlu pisahkan akun/model, isi hanya baris fitur yang diubah.
#      Kosong = pakai nilai global, jadi tidak wajib mengisi semua.
#
# Contoh memakai 3 akun berbeda pada satu provider:
#   AI_CHAT_PROVIDER=openai
#   AI_CHAT_API_KEY=<key akun 1>
#   AI_CHAT_MODEL=<model untuk chatbot>
#   AI_BK_PROVIDER=openai
#   AI_BK_API_KEY=<key akun 2>
#   AI_BK_MODEL=<model untuk triase, pilih yang konsisten JSON>
#   AI_CONTENT_PROVIDER=openai
#   AI_CONTENT_API_KEY=<key akun 3>
#   AI_CONTENT_MODEL=<model untuk draf, perlu panjang/naratif>
#
# BASE_URL hanya dipakai provider openai-compatible (OpenRouter, Groq, Together,
# DeepSeek, Ollama/vLLM lokal, dll) dan harus ditulis penuh sampai /chat/completions.
AI_CHAT_PROVIDER=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_BASE_URL=

AI_BK_PROVIDER=
AI_BK_API_KEY=
AI_BK_MODEL=
AI_BK_BASE_URL=

AI_CONTENT_PROVIDER=
AI_CONTENT_API_KEY=
AI_CONTENT_MODEL=
AI_CONTENT_BASE_URL=

# --- Database MySQL ---
# Lokal (XAMPP/Laragon): default di bawah sudah cocok (root tanpa password).
# Hostinger:
#   DB_HOST = hostname MySQL dari hPanel > Remote MySQL (BUKAN URL phpMyAdmin),
#             atau "localhost" bila PHP berjalan di hosting yang sama dengan DB.
#   DB_PORT = 3306 (port default remote MySQL Hostinger).
#   DB_NAME / DB_USER memakai awalan akun, contoh:
#             u104889167_admin_dash_24 / u104889167_admin24.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smkn24
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Opsional: direktori writable untuk arsip/bukti, HARUS di luar document root.
# Jika kosong, backend memakai satu tingkat di atas document root.
# PRIVATE_UPLOAD_DIR=/home/akun/.smkn24-private-uploads

# --- Auth ---
JWT_SECRET=ubah-string-ini-menjadi-acak-dan-rahasia
