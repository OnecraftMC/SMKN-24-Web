# =============================================================================
# Salin file ini menjadi ".env.local" (atau set di panel hosting) lalu isi.
# JANGAN PERNAH commit file .env / .env.local / secret ke repository.
# =============================================================================
#
# Istilah:
#   server-only  = hanya dibaca Next.js di server (render, route handler).
#                  TIDAK pernah masuk ke browser.
#   NEXT_PUBLIC_* = di-compile saat BUILD dan ditanam pada bundle browser.
#                  JANGAN PERNAH diisi secret.
#   Variabel ini di-compile saat build — isi sebelum `next build`, bukan sesudah.
#

# --- server-only -------------------------------------------------------------
# URL legacy PHP, dipakai untuk aset lama di /backend/uploads.
# API Laravel dipilih terpisah melalui LARAVEL_API_URL.
#
# PENTING (Windows): pakai 127.0.0.1, BUKAN localhost. "localhost" sering
# resolve ke ::1 (IPv6) sedangkan `php -S 127.0.0.1:8000` hanya listen di
# IPv4 — akibatnya semua proxy /api/* membalas 404 dengan halaman error PHP.
BACKEND_URL=https://domain-anda.id/backend

# URL root Laravel API; document root subdomain harus menunjuk ke
# backend-laravel/public. Jangan tambahkan /api pada akhir URL.
LARAVEL_API_URL=https://api.domain-anda.id

# --- NEXT_PUBLIC (ditanam ke browser) ---------------------------------------
# Base URL Laravel API untuk permintaan browser (dashboard admin: CRUD + upload).
# NEXT_PUBLIC_API_URL ditanam ke bundle saat build.
#   dev (dua server)        : http://127.0.0.1:8000/backend
NEXT_PUBLIC_API_URL=https://api.domain-anda.id

# Origin website yang menyajikan aset lama seperti /backend/uploads/...
NEXT_PUBLIC_ASSET_URL=https://domain-anda.id

# Tautan "Kembali ke situs utama" di halaman login.
# Same-origin => "/"
NEXT_PUBLIC_MAIN_WEB_URL=/

# Tautan Login pada Navbar/MobileMenu (opsional).
# Aplikasi gabungan sudah memakai "/login" pada origin yang sama; isi hanya
# bila situs publik dan admin sengaja dipisah.
NEXT_PUBLIC_ADMIN_URL=/login

# Origin lintas-origin yang diizinkan route /api/* Next.js.
# Kosongkan (default) untuk pemakaian same-origin — tidak perlu CORS.
ADMIN_ORIGIN=
