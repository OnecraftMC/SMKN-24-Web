# Origin backend PHP — dibaca HANYA di server (bukan NEXT_PUBLIC_).
# Dipakai dua tempat: fetch data publik di lib/api.ts, dan
# next.config.ts -> images.remotePatterns untuk melayani gambar backend.
# Isi URL HTTP ke folder /backend — BUKAN host/port database (3306 ditolak).
BACKEND_URL=http://localhost:8000

# URL dashboard admin tempat tombol Login pada situs publik mengarah.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Origin admin untuk konfigurasi CORS/monorepo.
ADMIN_ORIGIN=http://localhost:3001
